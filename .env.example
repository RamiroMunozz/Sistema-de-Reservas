# Copiar como .env en la raíz para usar docker compose.
# Generar el secreto con: openssl rand -base64 48
JWT_SECRET=

# Necesarias solo para cobrar con Mercado Pago.
# BACKEND_URL es la URL pública del backend, sin barra final.
BACKEND_URL=
FRONTEND_URL=http://localhost:5173
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de la sección Webhooks en "Tus integraciones" de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET=
