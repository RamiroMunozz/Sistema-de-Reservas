generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------
// ENUMS
// ------------------------------------

enum Role {
  JUGADOR
  DUENO
  SUPER_ADMIN
}

enum Sport {
  FUTBOL_5
  FUTBOL_7
  PADEL
  TENIS
}

enum Surface {
  SINTETICO
  CEMENTO
  POLVO_LADRILLO
  PARQUET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum PaymentMethod {
  CASH
  TRANSFER
  MERCADOPAGO
}

enum RefundReason {
  AMOUNT_MISMATCH
  SLOT_TAKEN
  PAID_AFTER_CANCEL
  DUPLICATE_PAYMENT
  OWNER_DISCRETION
}

// ------------------------------------
// MODELOS
// ------------------------------------

// La migración 20261125120000_negocios agrega una restricción que Prisma no representa:
// users_un_dueno_por_negocio (EXCLUDE parcial: a lo sumo un usuario por negocio_id no nulo) y
// users_negocio_segun_rol (CHECK: solo el DUENO tiene negocio, migración 20261125120100_roles_negocio).
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  role         Role      @default(JUGADOR)
  negocioId    String?   @map("negocio_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  negocio      Negocio?  @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  bookings     Booking[]

  @@map("users")
}

// Cada negocio es un tenant: sus complejos, canchas y reservas le pertenecen.
model Negocio {
  id        String   @id @default(uuid()) @db.Uuid
  nombre    String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(40)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  complejos Complex[]
  reservas  Booking[]
  usuarios  User[]

  @@map("negocios")
}

// La migración 20261119120000_reserva_invitado agrega una restricción que Prisma no
// representa: complexes_porcentaje_sena_valido (deposit_percent entre 1 y 100).
model Complex {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(150)
  address        String   @db.VarChar(255)
  phone          String?  @db.VarChar(30)
  depositPercent Int      @default(30) @map("deposit_percent")
  negocioId      String   @map("negocio_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  negocio Negocio @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  courts  Court[]

  @@index([negocioId])
  @@map("complexes")
}

model Court {
  id           String          @id @default(uuid()) @db.Uuid
  complexId    String          @map("complex_id") @db.Uuid
  name         String          @db.VarChar(100)
  sport        Sport
  surface      Surface
  pricePerSlot Decimal         @map("price_per_slot") @db.Decimal(10, 2)
  isIndoor     Boolean         @default(false) @map("is_indoor")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  complex      Complex         @relation(fields: [complexId], references: [id], onDelete: Cascade)
  schedules    CourtSchedule[]
  bookings     Booking[]

  @@index([complexId, sport])
  @@map("courts")
}

model CourtSchedule {
  id                  String   @id @default(uuid()) @db.Uuid
  courtId             String   @map("court_id") @db.Uuid
  dayOfWeek           Int      @map("day_of_week")
  openTime            DateTime @map("open_time") @db.Time()
  closeTime           DateTime @map("close_time") @db.Time()
  slotDurationMinutes Int      @default(60) @map("slot_duration_minutes")

  court               Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([courtId, dayOfWeek])
  @@map("court_schedules")
}

// Restricciones que Prisma no representa:
// - 20261104120000_reservas_sin_solapamiento: bookings_horario_valido.
// - 20261119120000_reserva_invitado: bookings_titular_valido (o hay cuenta o hay
//   teléfono de invitado, nunca ambos ni ninguno).
// - 20261119120100_sin_solapamiento_excluye_vencidas: bookings_sin_solapamiento
//   (EXCLUDE gist que ignora CANCELLED y EXPIRED).
// - 20261125120000_negocios: el trigger bookings_negocio_coherente (negocio_id de la reserva
//   igual al del complejo de su cancha).
model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  userId              String?       @map("user_id") @db.Uuid
  courtId             String        @map("court_id") @db.Uuid
  negocioId           String        @map("negocio_id") @db.Uuid
  startTime           DateTime      @map("start_time") @db.Timestamptz()
  endTime             DateTime      @map("end_time") @db.Timestamptz()
  totalPrice          Decimal       @map("total_price") @db.Decimal(10, 2)
  status              BookingStatus @default(CONFIRMED)
  paymentMethod       PaymentMethod @default(CASH) @map("payment_method")
  guestFirstName      String?       @map("guest_first_name") @db.VarChar(100)
  guestLastName       String?       @map("guest_last_name") @db.VarChar(100)
  guestPhone          String?       @map("guest_phone") @db.VarChar(15)
  guestEmail          String?       @map("guest_email") @db.VarChar(255)
  expiresAt           DateTime?     @map("expires_at") @db.Timestamptz()
  depositAmount       Decimal?      @map("deposit_amount") @db.Decimal(10, 2)
  accessTokenHash     String?       @unique @map("access_token_hash") @db.Char(64)
  mpPreferenceId      String?       @map("mp_preference_id") @db.VarChar(100)
  depositPaidAtCancel Boolean?      @map("deposit_paid_at_cancel")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  user     User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  court    Court            @relation(fields: [courtId], references: [id], onDelete: Restrict)
  negocio  Negocio          @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  payments BookingPayment[]

  @@index([courtId, startTime, endTime])
  @@index([userId, startTime])
  @@index([status, expiresAt])
  @@index([negocioId, startTime])
  @@index([negocioId, guestPhone, status])
  @@map("bookings")
}

// La migración 20261119120000_reserva_invitado agrega restricciones que Prisma no
// representa: booking_payments_motivo_coherente y booking_payments_un_pago_valido.
model BookingPayment {
  id           String        @id @default(uuid()) @db.Uuid
  bookingId    String        @map("booking_id") @db.Uuid
  mpPaymentId  String        @unique @map("mp_payment_id") @db.VarChar(30)
  amount       Decimal       @db.Decimal(10, 2)
  isValid      Boolean       @map("is_valid")
  refundReason RefundReason? @map("refund_reason")
  refundedAt   DateTime?     @map("refunded_at") @db.Timestamptz()
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("booking_payments")
}
